{
  "scopeName": "source.khaki",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#type-names"
    },
    {
      "include": "#names"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],

  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.khaki",
          "match": "\\b(func|cor|if|then|else|while|yield)\\b"
        },
        {
          "name": "storage.modifier.khaki",
          "match": "\\b(let|set|struct|open)\\b"
        },
        {
          "name": "storage.type.khaki",
          "match": "\\b(any)\\b"
        }
      ]
    },

    "boolean": {
      "patterns": [
        {
          "name": "constant.language.boolean.khaki",
          "match": "\\b(True|False)\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.khaki",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.khaki",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "names": {
      "patterns": [
        {
          "name": "variable.other.khaki",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.khaki",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.khaki",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.khaki",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.bitwise.khaki",
          "match": "<<|>>|\\||~|\\^"
        },
        {
          "name": "keyword.operator.arithmetic.khaki",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.dereference.khaki",
          "match": "&"
        },
        {
          "name": "keyword.operator.not.khaki",
          "match": "!"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.khaki",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.khaki",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.block.begin.khaki",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.khaki",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.khaki",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.khaki",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.khaki",
          "match": ",|;"
        },
        {
          "name": "punctuation.separator.type.khaki",
          "match": "::|:"
        },
        {
          "name": "punctuation.accessor.khaki",
          "match": "\\."
        }
      ]
    }
  }
}
